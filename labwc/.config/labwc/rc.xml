<labwc_config>

<!-- Configuração mouse -->

<libinput>
  <device category="default">
    <pointerSpeed>-0.3</pointerSpeed>
    <accelProfile>flat</accelProfile>
  </device>
</libinput>

<!-- Workspaces -->
<desktops number="9"/>

<!-- Configuração das Keybinds -->

<keyboard>
  <default />
  <keybind key="W-d">
    <action name="Execute" command="bemenu-run -b" />
  </keybind>

  <keybind key="W-1">
    <action name="GoToDesktop">
      <to>1</to>
    </action>
  </keybind>

  <keybind key="W-2">
    <action name="GoToDesktop">
      <to>2</to>
    </action>
  </keybind>
  
  <keybind key="W-3">
    <action name="GoToDesktop">
      <to>3</to>
    </action>
  </keybind>

  <keybind key="W-4">
    <action name="GoToDesktop">
      <to>4</to>
    </action>
  </keybind>

  <keybind key="W-5">
    <action name="GoToDesktop">
      <to>5</to>
    </action>
  </keybind>

  <keybind key="W-6">
    <action name="GoToDesktop">
      <to>6</to>
    </action>
  </keybind>

  <keybind key="W-7">
    <action name="GoToDesktop">
      <to>7</to>
    </action>
  </keybind>

  <keybind key="W-8">
    <action name="GoToDesktop">
      <to>8</to>
    </action>
  </keybind>

  <keybind key="W-9">
    <action name="GoToDesktop">
      <to>9</to>
    </action>
  </keybind>

  <keybind key="W-A-1">
    <action name="SendToDesktop">
      <to>1</to>
    </action>
  </keybind>

  <keybind key="W-A-2">
    <action name="SendToDesktop">
      <to>2</to>
    </action>
  </keybind>
  
  <keybind key="W-A-3">
    <action name="SendToDesktop">
      <to>3</to>
    </action>
  </keybind>

  <keybind key="W-A-4">
    <action name="SendToDesktop">
      <to>4</to>
    </action>
  </keybind>

  <keybind key="W-A-5">
    <action name="SendToDesktop">
      <to>5</to>
    </action>
  </keybind>

  <keybind key="W-A-6">
    <action name="SendToDesktop">
      <to>6</to>
    </action>
  </keybind>

  <keybind key="W-A-7">
    <action name="SendToDesktop">
      <to>7</to>
    </action>
  </keybind>

  <keybind key="W-A-8">
    <action name="SendToDesktop">
      <to>8</to>
    </action>
  </keybind>

  <keybind key="W-A-9">
    <action name="SendToDesktop">
      <to>9</to>
    </action>
  </keybind>
</keyboard>

<!-- WindowRules -->

<windowRules>
  <windowRule identifier="*" serverDecoration="no" />
  <windowRule identifier="Conky" serverDecoration="no" >
     <sticky>yes</sticky>
     <layer>background</layer>
     <skipTaskbar>yes</skipTaskbar>
     <skipSwitchMenu>yes</skipSwitchMenu>
  </windowRule>
</windowRules>

<!-- Core -->

<core>
  <allowTearing>yes</allowTearing>
</core>

<!-- Theme -->

<theme>
    <keepBorder>yes</keepBorder>
</theme>
</labwc_config>
